{
  "name": "lexipop",
  "productName": "LexiPop",
  "version": "1.0.5",
  "description": "LexiPop by NexaSecure AI",
  "author": "NexaSecure AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && concurrently \"vite\" \"wait-on http://localhost:5123 && electron .\"",
    "build": "tsc -p tsconfig.json && vite build",
    "dist": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.lexipop.app",
    "productName": "LexiPop",
    "copyright": "Copyright © 2026 NexaSecure AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LexiPop",
      "runAfterFinish": true,
      "artifactName": "LexiPop-Setup-${version}.exe"
    },
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false
  }
}
